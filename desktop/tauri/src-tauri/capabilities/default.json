{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Sayelf setup window: native folder picker and bundled bootstrap sidecar only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/sayelf-runtime", "sidecar": true, "args": true }]
    }
  ]
}
