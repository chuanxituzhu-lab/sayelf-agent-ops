{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Sayelf local workbench: native file dialogs and the bundled runtime sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/sayelf-runtime", "sidecar": true, "args": true }]
    }
  ]
}
